[Unit]
Description=Azazel Trader - bot-nastavnik (Telegram + Airtable)
Documentation=https://github.com/RuslanOss/azazelm.ton
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/azabot
EnvironmentFile=-/opt/azabot/.env
ExecStart=/usr/bin/python3 /opt/azabot/bot.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/azabot.log
StandardError=append:/var/log/azabot.log
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
